# Auth Service Environment Variables
# Copy this file to .env and fill in the values

# JWT Configuration (REQUIRED) — HS512, minimum 64 bytes (e.g. `openssl rand -hex 32` → 64 chars)
JWT_SECRET=replace-with-64-byte-random-secret-eg-openssl-rand-hex-32-output

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aether_auth
SPRING_DATASOURCE_USERNAME=aether
SPRING_DATASOURCE_PASSWORD=your-db-password

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
