# === Claro Backend ===
GOOGLE_API_KEY=your_google_api_key_here

# Ollama (로컬 LLM)
# OLLAMA_BASE_URL=http://localhost:11434       # 로컬 개발
# OLLAMA_BASE_URL=http://host.docker.internal:11434  # Docker

# 모델 디바이스 (cpu / cuda)
# DEVICE=cpu

# === Docker 볼륨 경로 (docker-compose 전용) ===
# MODELS_PATH=/path/to/CIVILCOMPLAINT/models
# DATA_PATH=/path/to/CIVILCOMPLAINT/data
# RESULTS_PATH=/path/to/CIVILCOMPLAINT/results

# === Frontend ===
# BACKEND_URL=http://localhost:8010             # 로컬 개발
# BACKEND_URL=http://backend:8000              # Docker
