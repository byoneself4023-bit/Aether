# ============================================
# Aether - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_DB=aether_auth
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether123

# ============================================
# JWT Configuration
# ============================================
# Secret key for JWT signing (minimum 32 characters)
JWT_SECRET=aether-jwt-secret-key-minimum-32-characters-long-for-hmac-sha256
# Access token expiration in milliseconds (default: 30 minutes)
JWT_ACCESS_EXPIRATION=1800000
# Refresh token expiration in milliseconds (default: 7 days)
JWT_REFRESH_EXPIRATION=604800000

# ============================================
# LLM Service Configuration
# ============================================
# Google Gemini API Key (required for AI features)
GOOGLE_API_KEY=your-gemini-api-key-here

# ============================================
# Frontend Configuration (for browser)
# ============================================
# These are exposed to the browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_AUTH_URL=http://localhost:8003
NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:8001
NEXT_PUBLIC_LLM_URL=http://localhost:8002
